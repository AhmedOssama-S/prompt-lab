# Copy to .env and fill in. Names match production exactly (see schemas/SCHEMAS.md)
# so a real deployment's values can be pasted in unchanged.

GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

core42_api_key=
core42_base_url=
core42_gpt51_model=
core42_gpt41_model=
core42_fallback_model=

# gpt-6 is a Prompt Lab-only option -- no production deployment uses it, so
# these names have no production counterpart to match. It sits behind its own
# subscription: set core42_gpt6_api_key (and core42_gpt6_base_url, if the
# deployment is on a different endpoint). Both fall back to the main core42_*
# values above, so if gpt-6 is served off the same key and URL, only
# core42_gpt6_model is needed. Leave core42_gpt6_model blank to hide the model.
# The deployment is named gpt-6-sol on api.core42.ai -- plain "gpt-6" 404s.
core42_gpt6_model=
core42_gpt6_api_key=
core42_gpt6_base_url=

# Optional: makes drafts (Prompts -> Handoff) survive a restart on Streamlit
# Community Cloud by storing them in Supabase instead of local files. Leave
# both blank to keep using local files (the default -- fine for self-hosting
# or local dev). See drafts/schema.sql and DEPLOY.md, "Making drafts survive".
# SUPABASE_KEY must be the service_role key, not anon -- see supabase_backend.py.
SUPABASE_URL=
SUPABASE_KEY=
