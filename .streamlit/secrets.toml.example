# Copy to .streamlit/secrets.toml for local use, or paste the contents into your
# host's secrets UI (on Streamlit Community Cloud: App menu -> Settings -> Secrets).
#
# .streamlit/secrets.toml is gitignored. NEVER commit real keys.
#
# Key names match production's environment variables exactly, and every entry
# here is deliberately TOP-LEVEL (no [sections]). Streamlit exposes root-level
# secrets as environment variables, but sectioned ones only via st.secrets --
# and runner/engine.py::setup_clients() reads os.environ. Nesting these under a
# [section] would make every provider silently appear "not configured".

# --- Google Gemini ---
GOOGLE_API_KEY = ""

# --- Core42 (OpenAI-SDK-compatible endpoint, NOT Azure) ---
core42_api_key = ""
core42_base_url = ""
core42_gpt51_model = "gpt-5.1"
core42_gpt41_model = "gpt-4.1"
core42_fallback_model = "gpt-4.1-mini"

# gpt-6: Prompt Lab-only (no production deployment uses it), on its own
# subscription. core42_gpt6_api_key / core42_gpt6_base_url both fall back to the
# main core42_* values above, so drop them if gpt-6 shares the same endpoint.
# Leave core42_gpt6_model blank or unset to hide the model from the UI.
core42_gpt6_model = "gpt-6-sol"   # the deployment name; plain "gpt-6" 404s
core42_gpt6_api_key = ""
core42_gpt6_base_url = ""

# --- Optional. Neither is offered in the UI any more (see README), but
# --- test_engine.py --live still exercises their call paths if set.
# ANTHROPIC_API_KEY = ""
# OPENAI_API_KEY = ""

# --- Deployment behaviour ---
# Set to "1" only when the filesystem genuinely persists across restarts (a VM,
# a mounted volume). Leaving it unset on an ephemeral host keeps the
# "proposals will be lost" warning visible on the Prompts and Handoff pages.
# PROMPT_LAB_PERSISTENT_STORAGE = "1"
